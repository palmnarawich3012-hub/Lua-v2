MainTab:CreateSection("Physics & Combat Mechanics")

local TouchFlingEnabled = false
local TouchConnection = nil

-- สวิตช์เปิด-ปิดระบบ Drop Kick / Touch Fling (เดินชนแล้วปลิว)
MainTab:CreateToggle({
    Name = "Drop Kick (แตะแล้วปลิว)",
    CurrentValue = false,
    Flag = "DropKickToggle",
    Callback = function(Value)
        TouchFlingEnabled = Value

        if TouchFlingEnabled then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart

                -- ตรวจจับการแตะ/ชน
                TouchConnection = hrp.Touched:Connect(function(hit)
                    if not TouchFlingEnabled then return end
                    
                    local targetChar = hit.Parent
                    local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
                    local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")

                    -- ตรวจสอบว่าตัวที่ชนเป็นผู้เล่นอื่น และไม่ใช่ตัวเราเอง
                    if targetHrp and targetHumanoid and targetChar ~= char then
                        -- คำนวณทิศทางแรงผลัก (ผลักไปข้างหน้า + ยกขึ้นฟ้า)
                        local pushDirection = hrp.CFrame.LookVector * 150 + Vector3.new(0, 100, 0)
                        
                        -- ส่งแรงอัดให้เป้าหมายกระเด็นปลิว
                        targetHrp.AssemblyLinearVelocity = pushDirection
                    end
                end)
            end
        else
            if TouchConnection then
                TouchConnection:Disconnect()
                TouchConnection = nil
            end
        end
    end,
})

-- ปุ่มเด้งขึ้นฟ้า
MainTab:CreateButton({
    Name = "Launch Upward (เด้งขึ้นฟ้า)",
    Callback = function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 150, hrp.AssemblyLinearVelocity.Z)
        end
    end,
})

