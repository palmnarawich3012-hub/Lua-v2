local function RefreshFileList()
    for _, v in pairs(ExecFileScroll:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end
    
    local files = {}
    if listfiles then
        pcall(function()
            for _, file in ipairs(listfiles("")) do
                local cleanName = file:match("^.+[/\\]([^/\\]+)$") or file
                table.insert(files, cleanName)
            end
        end)
    end
    
    if #files == 0 then table.insert(files, "ไม่พบไฟล์ในระบบ") end
    
    for _, fileName in ipairs(files) do
        local fileBtn = Instance.new("TextButton")
        fileBtn.Parent = ExecFileScroll
        fileBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        fileBtn.BorderColor3 = Color3.fromRGB(50, 50, 50)
        fileBtn.Size = UDim2.new(1, 0, 0, 28)
        fileBtn.Font = Enum.Font.SourceSans
        fileBtn.Text = "  " .. fileName
        fileBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
        fileBtn.TextSize = 13.000
        fileBtn.TextXAlignment = Enum.TextXAlignment.Left
        fileBtn.ZIndex = 6
        
        local function selectFileAction()
            if fileName ~= "ไม่พบไฟล์ในระบบ" then
                ExecFileNameBox.Text = fileName
                if readfile and isfile and isfile(fileName) then
                    local success, content = pcall(function() return readfile(fileName) end)
                    if success then
                        ExecTextBox.Text = content
                        Rayfield:Notify({Title = "File Manager", Content = "โหลดไฟล์ " .. fileName .. " สำเร็จ!", Duration = 2})
                    end
                end
            end
            ExecFileScroll.Visible = false
        end
        
        fileBtn.MouseButton1Click:Connect(selectFileAction)
        fileBtn.TouchTap:Connect(selectFileAction)
    end
    ExecFileScroll.CanvasSize = UDim2.new(0, 0, 0, #files * 28)
end

