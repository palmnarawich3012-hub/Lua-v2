SpyTab:CreateSection("SimpleSpy V3 Controls")

SpyTab:CreateButton({
    Name = "Execute SimpleSpy V3",
    Callback = function()
        task.spawn(function()
            local success, err = pcall(function()
                loadstring(game:HttpGet("https://raw.githubusercontent.com/78n/SimpleSpy/main/SimpleSpySource.lua"))()
            end)
            if not success then
                loadstring(game:HttpGet("https://raw.githubusercontent.com/exxtremeshadow/SimpleSpySource/master/SimpleSpy.lua"))()
            end
        end)
        Rayfield:Notify({Title = "SimpleSpy", Content = "SimpleSpy V3 Executed!", Duration = 3})
    end,
})

