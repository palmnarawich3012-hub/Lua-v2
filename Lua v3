ESPTab:CreateSection("Player ESP Controls")

local ESP_Enabled = false
local TeamCheck_Enabled = false
local ESP_Boxes = {}

local function RemoveESP(player)
    if ESP_Boxes[player] then
        if ESP_Boxes[player].Highlight then ESP_Boxes[player].Highlight:Destroy() end
        if ESP_Boxes[player].Billboard then ESP_Boxes[player].Billboard:Destroy() end
        ESP_Boxes[player] = nil
    end
end

local function ApplyESP(player)
    if player == LocalPlayer then return end

    local function CharacterAdded(character)
        RemoveESP(player)
        if not ESP_Enabled then return end

        if TeamCheck_Enabled and player.Team ~= nil and player.Team == LocalPlayer.Team then
            return
        end

        local hrp = character:WaitForChild("HumanoidRootPart", 5)
        local humanoid = character:WaitForChild("Humanoid", 5)

        if hrp and humanoid then
            local isSameTeam = (player.Team ~= nil and player.Team == LocalPlayer.Team)
            local boxColor = isSameTeam and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)

            local highlight = Instance.new("Highlight")
            highlight.Name = "ESPHighlight"
            highlight.Adornee = character
            highlight.FillColor = boxColor
            highlight.FillTransparency = 0.5
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.OutlineTransparency = 0
            highlight.Parent = character

            local billboard = Instance.new("BillboardGui")
            billboard.Name = "ESPName"
            billboard.Adornee = hrp
            billboard.Size = UDim2.new(0, 200, 0, 50)
            billboard.StudsOffset = Vector3.new(0, 3, 0)
            billboard.AlwaysOnTop = true

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Parent = billboard
            nameLabel.Size = UDim2.new(1, 0, 1, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.TextColor3 = boxColor
            nameLabel.TextStrokeTransparency = 0
            nameLabel.TextSize = 14
            nameLabel.Font = Enum.Font.SourceSansBold

            local function updateText()
                if humanoid and humanoid.Health > 0 then
                    nameLabel.Text = string.format("%s | HP: %d/%d", player.Name, math.floor(humanoid.Health), math.floor(humanoid.MaxHealth))
                else
                    nameLabel.Text = player.Name .. " [DEAD]"
                end
            end

            updateText()
            humanoid.HealthChanged:Connect(updateText)
            billboard.Parent = character

            ESP_Boxes[player] = {
                Highlight = highlight,
                Billboard = billboard
            }
        end
    end

    if player.Character then
        task.spawn(function() CharacterAdded(player.Character) end)
    end
    player.CharacterAdded:Connect(CharacterAdded)
end

local function RefreshESP()
    for player, _ in pairs(ESP_Boxes) do
        RemoveESP(player)
    end
    if ESP_Enabled then
        for _, player in ipairs(Players:GetPlayers()) do
            ApplyESP(player)
        end
    end
end

ESPTab:CreateToggle({
    Name = "Enable Player ESP",
    CurrentValue = false,
    Flag = "PlayerESPToggle",
    Callback = function(Value)
        ESP_Enabled = Value
        RefreshESP()
    end,
})

ESPTab:CreateToggle({
    Name = "Team Check (Hide Teammates)",
    CurrentValue = false,
    Flag = "TeamCheckToggle",
    Callback = function(Value)
        TeamCheck_Enabled = Value
        RefreshESP()
    end,
})

