        toggleUI()
    end
end)

-- [[ ฟังก์ชันทำให้ตัวละครปลิวตามระดับ ]] --
local function launchCharacter(powerLevel)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    -- คำนวณทิศทางการปลิว (พุ่งขึ้นฟ้าและไปข้างหน้าตามมุมมอง)
    local lookVec = workspace.CurrentCamera.CFrame.LookVector
    local forceVector = Vector3.new(0, 0, 0)
    
    if powerLevel == 1 then
        forceVector = Vector3.new(0, 65, 0) + (lookVec * 25) -- ระดับ 1: กระโดดสูงเบาๆ
    elseif powerLevel == 2 then
        forceVector = Vector3.new(0, 120, 0) + (lookVec * 70) -- ระดับ 2: พุ่งตัวกลาง
    elseif powerLevel == 3 then
        forceVector = Vector3.new(0, 250, 0) + (lookVec * 180) -- ระดับ 3: ปลิวกระเด็นรุนแรงสะใจ
    end
    
    -- ใช้ LinearVelocity หรือการใส่ Velocity ตรงๆ เข้าไปที่ HumanoidRootPart
    hrp.AssemblyLinearVelocity = forceVector
end

-- ผูกฟังก์ชันเข้ากับปุ่ม UI
btnLevel1.MouseButton1Click:Connect(function() launchCharacter(1) end)
btnLevel2.MouseButton1Click:Connect(function() launchCharacter(2) end)
btnLevel3.MouseButton1Click:Connect(function() launchCharacter(3) end)
